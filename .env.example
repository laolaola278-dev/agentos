# AgentOS environment — copy to .env and adjust.

# PostgreSQL (required for the dashboard / `--store pg`); not needed for CLI-only use.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional LLM (any OpenAI-compatible endpoint: OpenAI, DeepSeek, GLM, Ollama, vLLM...).
# Enables model planning, independent model review, and `mode: "agentic"` tasks.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_MS=120000
# LLM_MAX_RETRIES=2
# LLM_JSON_MODE=true

# Runtime overrides
# AGENTOS_STORE=sqlite
# AGENTOS_SHELL=
# AGENTOS_CONCURRENCY=2
# AGENTOS_ROOT=
